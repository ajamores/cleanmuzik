# CleanMuzik — environment template.
# Copy this file to `.env` (which is git-ignored) and fill in the real values.
# `server/app/config.py` reads `.env` at boot (the "nothing reads this yet" note here
# was true only until T-001 built the backend).

# --- Data dir (SQLite DBs + the staging root) -------------------------------
# DB_PATH names the app's own database. The beets library DB and, since T-106, the
# staging root that holds parked reviews' audio are BOTH derived from its parent —
# so this one value places the whole data dir. Point it at the LINUX filesystem,
# not at `server/data`, whenever the repo lives under a cloud-synced folder
# (OneDrive/Dropbox): sync would upload every downloaded song, can dehydrate a
# long-parked staging file into a placeholder WSL cannot open, and holds handles
# that make cleanup fail silently. The Jellyfin library is a separate path
# (`beets_engine.LIBRARY_DIRECTORY`) and must stay where Jellyfin can read it.
# Defaults to `server/data/cleanmuzik.db` when unset — leave COMMENTED OUT to get
# that default. An empty `DB_PATH=` is not the same thing: it parses as an empty
# path and the data dir resolves somewhere useless.
# DB_PATH=/home/you/cleanmuzik-data/cleanmuzik.db

# --- Jellyfin (auto-scan after a track lands) -------------------------------
# JELLYFIN_URL: where Jellyfin is reachable. Phase 0 = the laptop itself.
JELLYFIN_URL=http://localhost:8096
# JELLYFIN_API_KEY: Jellyfin Dashboard -> API Keys -> New. Paste it in `.env`, not here.
JELLYFIN_API_KEY=

# --- Last.fm (genre tags via beets `lastgenre`) -----------------------------
# Not obtained yet. Until set, tracks land without genre (not a failure).
LASTFM_APIKEY=

# --- AcoustID (fingerprint lookup via beets `chroma`) -----------------------
# OPTIONAL — beets' built-in key works (proven in the spike). Set only for
# higher rate limits.
ACOUSTID_APIKEY=
